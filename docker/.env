# Configuration variables for running Zebra in Docker

# Sets the path inside the container to a mounted Zebra config file.
# If unset, Zebra looks for ${HOME}/.config/zebrad.toml, then uses defaults.
# Environment variables below override values in the configuration file.
#
# CONFIG_FILE_PATH="/path/to/your/custom/zebrad.toml"

# Sets the network Zebra will run on.
#
# ZEBRA_NETWORK__NETWORK=Mainnet

# If behind a NAT, firewall, or load balancer, set this to your public IP:port
# so other Zcash nodes can connect to yours. Port 8233 for Mainnet, 18233 for
# Testnet.
#
# ZEBRA_NETWORK__EXTERNAL_ADDR=203.0.113.42:8233

# Zebra's RPC server is disabled by default. To enable it, set the listen address.
#
# ZEBRA_RPC__LISTEN_ADDR=0.0.0.0:8232   # Mainnet
# ZEBRA_RPC__LISTEN_ADDR=0.0.0.0:18232  # Testnet

# To disable cookie authentication, set the value below to false.
#
# ZEBRA_RPC__ENABLE_COOKIE_AUTH=true

# Sets a custom directory for the cookie authentication file.
#
# ZEBRA_RPC__COOKIE_DIR="/home/zebra/.config/cookie"

# Sets custom directories for the state and network caches.
#
# ZEBRA_STATE__CACHE_DIR="/home/zebra/.cache/zebra"
# ZEBRA_NETWORK__CACHE_DIR="/home/zebra/.cache/zebra"

# Sets custom Cargo features. Available features are listed at
# <https://docs.rs/zebrad/latest/zebrad/index.html#zebra-feature-flags>.
#
# Must be set at build time.
#
# FEATURES=""

# Sets the listen address and port for Prometheus metrics.
#
# ZEBRA_METRICS__ENDPOINT_ADDR="0.0.0.0:9999"

# Logging to a file is disabled by default. To enable it, uncomment the line
# below and alternatively set your own path.
#
# ZEBRA_TRACING__LOG_FILE="/home/zebra/.local/state/zebrad.log"

# Zebra uses colored logs for terminals and uncolored logs for files.
# Disable terminal colors with USE_COLOR, or force colors for files with FORCE_USE_COLOR.
#
# ZEBRA_TRACING__USE_COLOR=false
# ZEBRA_TRACING__FORCE_USE_COLOR=true

# To disable logging to journald, set the value to false.
# Requires the 'journald' feature at build time.
#
# ZEBRA_TRACING__USE_JOURNALD=true

# Sets the listen address and port for the tracing endpoint.
# Only active when the 'filter-reload' feature is enabled.
#
# ZEBRA_TRACING__ENDPOINT_ADDR="0.0.0.0:3000"

# If you are going to use Zebra as a backend for a mining pool, set your mining
# address.
#
# ZEBRA_MINING__MINER_ADDRESS="your_mining_address"

# Sets the runtime log filter.
#
# ZEBRA_TRACING__FILTER=info
