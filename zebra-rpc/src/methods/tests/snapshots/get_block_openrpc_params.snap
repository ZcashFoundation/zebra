            "type": "integer"
          },
          {
            "type": "boolean"
          },
          {
            "items": {
              "$ref": "#/components/schemas/GetBlockField"
            },
            "type": "array",
            "uniqueItems": true
          }
        ]
      }
    }
  },
  "params": [
    {
      "description": "The block hash or height to return.",
      "name": "hash_or_height",
